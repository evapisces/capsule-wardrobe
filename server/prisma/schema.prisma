generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  googleId  String?   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  closets   Closet[]
  capsules  Capsule[]
  trips     Trip[]
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Closet {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ClosetItem[]
}

model ClosetItem {
  id            String          @id @default(cuid())
  closetId      String
  name          String
  photoUrl      String?
  category      ItemCategory
  color         String?
  climate       Climate?
  size          String?
  brand         String?
  notes         String?
  pricePaid     Float?
  createdAt     DateTime        @default(now())
  closet        Closet          @relation(fields: [closetId], references: [id], onDelete: Cascade)
  capsules      CapsuleItem[]
  boardPositions BoardPosition[]
  outfits       OutfitItem[]
  wearEvents    WearEventItem[]
  packingItems  PackingItem[]
}

enum ItemCategory {
  tops
  bottoms
  dresses
  shoes
  accessories
  outerwear
}

enum Climate {
  tropical
  temperate
  cold
  layering
}

enum CapsuleKind {
  trip
  standing
}

model Capsule {
  id             String          @id @default(cuid())
  userId         String
  name           String
  description    String?
  kind           CapsuleKind     @default(standing)
  climate        Climate?
  tempHighF      Int?
  tempLowF       Int?
  createdAt      DateTime        @default(now())
  archivedAt     DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CapsuleItem[]
  trips          TripCapsule[]
  outfits        Outfit[]
  boardPositions BoardPosition[]
}

// Freeform position of a closet item on a capsule's outfit-building board,
// independent of whether it currently belongs to a named outfit.
model BoardPosition {
  capsuleId    String
  closetItemId String
  x            Float
  y            Float
  capsule      Capsule    @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  closetItem   ClosetItem @relation(fields: [closetItemId], references: [id], onDelete: Cascade)

  @@id([capsuleId, closetItemId])
}

// A named grouping of items within a capsule, drawn as a lasso rectangle
// on the board. Logging a wear against an outfit increments every item in it.
model Outfit {
  id         String       @id @default(cuid())
  capsuleId  String
  name       String
  createdAt  DateTime     @default(now())
  capsule    Capsule      @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  items      OutfitItem[]
  wearEvents WearEvent[]
}

model OutfitItem {
  outfitId     String
  closetItemId String
  outfit       Outfit     @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  closetItem   ClosetItem @relation(fields: [closetItemId], references: [id], onDelete: Cascade)

  @@id([outfitId, closetItemId])
}

enum WearSource {
  manual
  trip_auto
}

// One wear event = one day something was worn. Logging an outfit's wear
// fans out to every item in it via WearEventItem; a direct "Wore it today"
// on a single item (no outfit) creates a WearEventItem-only event.
model WearEvent {
  id        String          @id @default(cuid())
  date      DateTime        @db.Date
  outfitId  String?
  source    WearSource
  corrected Boolean         @default(false)
  context   String?
  createdAt DateTime        @default(now())
  outfit    Outfit?         @relation(fields: [outfitId], references: [id], onDelete: SetNull)
  items     WearEventItem[]
}

model WearEventItem {
  wearEventId  String
  closetItemId String
  wearEvent    WearEvent  @relation(fields: [wearEventId], references: [id], onDelete: Cascade)
  closetItem   ClosetItem @relation(fields: [closetItemId], references: [id], onDelete: Cascade)

  @@id([wearEventId, closetItemId])
}

model CapsuleItem {
  capsuleId    String
  closetItemId String
  capsule      Capsule    @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  closetItem   ClosetItem @relation(fields: [closetItemId], references: [id], onDelete: Cascade)

  @@id([capsuleId, closetItemId])
}

model Trip {
  id             String        @id @default(cuid())
  userId         String
  name           String
  destination    String
  startDate      DateTime
  endDate        DateTime
  autoLogEnabled Boolean       @default(true)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  capsules       TripCapsule[]
  packingItems   PackingItem[]
}

// One row per (trip, item) so the packing-list grid never has to
// conditionally omit the checkbox column.
model PackingItem {
  tripId       String
  closetItemId String
  packed       Boolean    @default(false)
  quantity     Int        @default(1)
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  closetItem   ClosetItem @relation(fields: [closetItemId], references: [id], onDelete: Cascade)

  @@id([tripId, closetItemId])
}

model TripCapsule {
  tripId    String
  capsuleId String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  capsule   Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  @@id([tripId, capsuleId])
}
