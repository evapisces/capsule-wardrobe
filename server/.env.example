DATABASE_URL=postgresql://capsule:capsule@localhost:5432/capsule_wardrobe
DATABASE_URL_TEST=postgresql://capsule:capsule@localhost:5432/capsule_wardrobe_test
PORT=3001
CLIENT_URL=http://localhost:5173
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=capsule-wardrobe-photos

# Google OAuth sign-in
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials, then add
# GOOGLE_REDIRECT_URI below as an authorized redirect URI on that client.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Name of the httpOnly session cookie set after a successful sign-in.
SESSION_COOKIE_NAME=capsule_session
