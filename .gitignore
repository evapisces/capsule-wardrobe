node_modules/
dist/
.env
.env.local
*.env

# Scratch dir written by client/src/__tests__/e2eTypecheck.test.ts while it
# proves a fixture/@capsule/shared mismatch fails tsc; cleaned up in afterAll.
client/e2e/__typecheck_probe_*/

# Playwright e2e artifacts
client/test-results/
client/playwright-report/
client/blob-report/
client/.playwright/

# Compiled JS output from tsc — the real sources are .ts/.tsx. These shadow the
# TS sources under Vite/Vitest resolution and must not be tracked. The client now
# type-checks with `tsc --noEmit`, so these should never be produced; kept as a
# belt-and-suspenders guard in case a stray `tsc` invocation emits alongside sources.
client/src/**/*.js
client/src/**/*.js.map
shared/types.js
